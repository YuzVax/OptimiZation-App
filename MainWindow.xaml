<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False" Title="OptimiZation · Versión 2" Height="850" Width="1360" MinHeight="780" MinWidth="1360" WindowStartupLocation="CenterScreen" Background="#0B0E14" Foreground="#E8EAED" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True">
<shell:WindowChrome.WindowChrome>
  <!-- CaptionHeight conserva arrastre, doble clic, menú del sistema y ajuste nativos. -->
  <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="8" NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
</shell:WindowChrome.WindowChrome>
<Window.Template><ControlTemplate TargetType="Window"><Border x:Name="MarcoVentana" Background="{TemplateBinding Background}" BorderThickness="0"><AdornerDecorator><ContentPresenter/></AdornerDecorator></Border><ControlTemplate.Triggers><Trigger Property="WindowState" Value="Maximized"><Setter TargetName="MarcoVentana" Property="Padding" Value="{x:Static SystemParameters.WindowResizeBorderThickness}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Window.Template>
<Window.Resources>
    <!-- También oscurece esquinas que conservan la plantilla temática de una tabla. -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#0B0E14"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#0B0E14"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#E8EAED"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E8EAED"/>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EAED"/><Setter Property="TextWrapping" Value="Wrap"/></Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="Background" Value="#2A2F3A"/>
      <Setter Property="Padding" Value="14,7"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Fondo" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fondo" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fondo" Property="Opacity" Value="0.7"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Fondo" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="BotonAcento" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Foreground" Value="#12161E"/>
      <Setter Property="Background">
        <Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FF8C00" Offset="0"/><GradientStop Color="#FF8C00" Offset="1"/></LinearGradientBrush></Setter.Value>
      </Setter>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="BotonPeligro" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#C62828"/>
    </Style>

    <!-- Texto sin efecto ni fondo por glifo. ClearType sobre una tarjeta opaca, no sobre el velo. -->
    <Style x:Key="TextoEmergente" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#F0F3F8"/><Setter Property="Background" Value="{x:Null}"/><Setter Property="Effect" Value="{x:Null}"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextHintingMode" Value="Fixed"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
      <Setter Property="LineHeight" Value="23"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>
    <Style x:Key="TituloEmergente" TargetType="TextBlock" BasedOn="{StaticResource TextoEmergente}">
      <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="#F5F7FA"/><Setter Property="LineHeight" Value="28"/>
    </Style>
    <Style x:Key="BotonEmergente" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#F5F7FA"/>
      <Setter Property="Background" Value="#344157"/><Setter Property="Padding" Value="18,10"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource TextoEmergente}" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="TextOptions.TextFormattingMode" Value="Display"/><Setter Property="TextOptions.TextHintingMode" Value="Fixed"/><Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
    </Style>
    <Style x:Key="BotonEmergenteAcento" TargetType="Button" BasedOn="{StaticResource BotonEmergente}"><Setter Property="Background" Value="#9A4900"/></Style>

    <!-- Botones de ventana propios: sin marco/caption claro del sistema. -->
    <Style x:Key="BotonVentana" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#B7C1CF"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="FondoVentana" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FondoVentana" Property="Background" Value="#202734"/><Setter Property="Foreground" Value="#FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="FondoVentana" Property="Background" Value="#303B4C"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FondoVentana" Property="Background" Value="#202734"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BotonCerrarVentana" TargetType="Button" BasedOn="{StaticResource BotonVentana}"><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="FondoCerrar" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsPressed" Value="True"><Setter TargetName="FondoCerrar" Property="Background" Value="#A62016"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FondoCerrar" Property="Background" Value="#C42B1C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

    <!-- Interruptor (toggle) -->
    <Style x:Key="Interruptor" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="36" Height="20" VerticalAlignment="Center">
                <Border x:Name="Pista" CornerRadius="10" Background="#303744"/>
                <Ellipse x:Name="Bola" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
              </Grid>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Pista" Property="Background" Value="#3D8BFD"/>
                <Setter TargetName="Bola" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="Bola" Property="Margin" Value="0,0,3,0"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Casilla (acciones que quitan/eliminan) -->
    <Style x:Key="Casilla" TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="Caja" Width="22" Height="22" CornerRadius="6" BorderThickness="2" BorderBrush="#5A6272" Background="#1A1D24" VerticalAlignment="Center">
                <TextBlock x:Name="Marca" Text="✓" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Caja" Property="Background" Value="#E5534B"/><Setter TargetName="Caja" Property="BorderBrush" Value="#E5534B"/>
                <Setter TargetName="Marca" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource Casilla}"/>

    <!-- Botón ⓘ desplegable -->
    <Style x:Key="BotonInfo" TargetType="ToggleButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="F" Width="22" Height="22" CornerRadius="11" Background="Transparent">
              <TextBlock x:Name="T" Text="ⓘ" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9AA4B2"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="F" Property="Background" Value="#FF8C00"/><Setter TargetName="T" Property="Foreground" Value="White"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="F" Property="Opacity" Value="0.85"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Iconos de trazo, indicador naranja y selección compacta. -->
    <Style x:Key="ElementoNav" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#758091"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
       <Grid Margin="0,3"><Border x:Name="F" Background="Transparent" CornerRadius="6" Margin="7,0" Padding="0,10"><ContentPresenter/></Border><Border x:Name="Indicador" Width="3" Height="27" Background="#FF8C00" HorizontalAlignment="Left" Visibility="Collapsed"/></Grid>
       <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="F" Property="Background" Value="#151B25"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="F" Property="Background" Value="#171E29"/><Setter Property="Foreground" Value="#FF9A24"/><Setter TargetName="Indicador" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Chip" TargetType="ToggleButton">
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" FontSize="11"/></DataTemplate></Setter.Value></Setter>
      <Setter Property="Foreground" Value="#99A3B2"/><Setter Property="Background" Value="#141A24"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,7,7"/><Setter Property="Padding" Value="11,6"/><Setter Property="FontSize" Value="11"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="F" Background="{TemplateBinding Background}" BorderBrush="#222A37" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="F" Property="Background" Value="#302117"/><Setter TargetName="F" Property="BorderBrush" Value="#A9651A"/><Setter Property="Foreground" Value="#FFA537"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="F" Property="BorderBrush" Value="#7E622F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Categoria" TargetType="ToggleButton" BasedOn="{StaticResource Chip}">
      <Setter Property="Padding" Value="13,9"/><Setter Property="FontSize" Value="12"/>
      <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" FontSize="12"/></DataTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip"><Setter Property="Background" Value="#19212D"/><Setter Property="Foreground" Value="#D5DCE6"/><Setter Property="BorderBrush" Value="#394355"/><Setter Property="Padding" Value="14"/><Setter Property="MaxWidth" Value="530"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#101216"/><Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="BorderBrush" Value="#252C38"/><Setter Property="Padding" Value="6,4"/><Setter Property="CaretBrush" Value="White"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#1A1D24"/><Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="RowBackground" Value="#12161E"/><Setter Property="AlternatingRowBackground" Value="#222731"/>
      <Setter Property="BorderBrush" Value="#252C38"/><Setter Property="GridLinesVisibility" Value="None"/>
      <Setter Property="HeadersVisibility" Value="Column"/><Setter Property="MinRowHeight" Value="32"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#262B35"/><Setter Property="Foreground" Value="#9AA4B2"/>
      <Setter Property="Padding" Value="8,6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#53351D"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Foreground" Value="#FF8C00"/><Setter Property="Background" Value="#262B35"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <!-- Pistas, pulgares y esquina siempre oscuros, también en TextBox y DataGrid. -->
    <Style x:Key="PulgarOscuro" TargetType="Thumb"><Setter Property="Background" Value="#303C50"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="4" Margin="2" MinWidth="6" MinHeight="6"/></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#53647D"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter Property="Background" Value="#99652D"/></Trigger></Style.Triggers></Style>
    <Style x:Key="PaginaScrollOscura" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#0B0E14"/><Setter Property="Width" Value="12"/><Setter Property="MinWidth" Value="0"/><Setter Property="Stylus.IsFlicksEnabled" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PaginaScrollOscura}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource PulgarOscuro}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PaginaScrollOscura}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="Horizontal" IsDirectionReversed="False" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource PaginaScrollOscura}" Command="{x:Static ScrollBar.PageLeftCommand}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Style="{StaticResource PulgarOscuro}"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource PaginaScrollOscura}" Command="{x:Static ScrollBar.PageRightCommand}"/></Track.IncreaseRepeatButton></Track></Border></ControlTemplate></Setter.Value></Setter></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Background" Value="#0B0E14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer"><Grid Background="{TemplateBinding Background}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" Margin="{TemplateBinding Padding}"/><ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/><ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{TemplateBinding HorizontalOffset}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"/><Border Grid.Row="1" Grid.Column="1" Background="#0B0E14"/></Grid></ControlTemplate></Setter.Value></Setter>
    </Style>
  
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#12161E"/><Setter Property="BorderBrush" Value="#202734"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#929CAB"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="8"/><Setter Property="MinWidth" Value="160"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#AAB3C0"/></Style>
  </Window.Resources>

  
<Grid x:Name="MarcoRaiz" Background="#0B0E14">
 <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
 <Grid.ColumnDefinitions><ColumnDefinition Width="96"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <CheckBox x:Name="ChkAvanzados" Visibility="Collapsed" IsChecked="False"/>
 <Border x:Name="BarraTitulo" Grid.ColumnSpan="2" Background="#0B0E14" BorderBrush="#202734" BorderThickness="0,0,0,1" CacheMode="BitmapCache"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0" IsHitTestVisible="False"><Image x:Name="ImgLogoTitulo" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="OptimiZation · Versión 2" FontSize="12" Foreground="#C5CEDA" VerticalAlignment="Center" TextWrapping="NoWrap"/></StackPanel>
  <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnMinimizar" Content="&#xE921;" ToolTip="Minimizar" AutomationProperties.Name="Minimizar" Style="{StaticResource BotonVentana}"/><Button x:Name="BtnMaximizar" Content="&#xE922;" ToolTip="Maximizar" AutomationProperties.Name="Maximizar" Style="{StaticResource BotonVentana}"/><Button x:Name="BtnCerrarVentana" Content="&#xE8BB;" ToolTip="Cerrar" AutomationProperties.Name="Cerrar" Style="{StaticResource BotonCerrarVentana}"/></StackPanel>
 </Grid></Border>
 <Border Grid.Row="1" Background="#0B1017" BorderBrush="#202734" BorderThickness="0,0,1,0"><DockPanel>
   <Button x:Name="BtnInicioLogo" DockPanel.Dock="Top" Margin="12,12,12,14" Padding="7" ContentTemplate="{x:Null}" Background="Transparent" ToolTip="Inicio" AutomationProperties.Name="Inicio" Cursor="Hand"><Image x:Name="ImgLogo" Width="38" Height="38" RenderOptions.BitmapScalingMode="HighQuality"/></Button>
   <StackPanel x:Name="PieSidebar" DockPanel.Dock="Bottom" Margin="10,8,4,10" HorizontalAlignment="Left"><TextBlock x:Name="TxtSistema" FontSize="10" Foreground="#6E7887"/><TextBlock x:Name="MarcaAutor" Text="by YuzVax" FontSize="10" Foreground="#BE854C" Margin="0,7,0,0" HorizontalAlignment="Left"/></StackPanel>
   <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ElementoNav}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
 </DockPanel></Border>
 <Grid Grid.Row="1" Grid.Column="1" Margin="24,16,18,12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel x:Name="CabeceraPagina" Grid.Row="0" Margin="0,0,0,17">
    <DockPanel x:Name="BarraModoOptimizar" Visibility="Collapsed" Margin="0,0,0,0" VerticalAlignment="Top"><Button x:Name="BtnVolverModos" DockPanel.Dock="Left" Content="← Elegir modo" Margin="0,0,14,0"/><Grid x:Name="BuscadorAjustes" DockPanel.Dock="Right" Visibility="Collapsed" Margin="12,0,0,0"><TextBox x:Name="TxtBuscarAjuste" Width="205" Padding="12,8" ToolTip="Buscar ajustes por nombre o explicación"/><TextBlock Text="⌕ Buscar ajustes" Foreground="#657081" Margin="12,8" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TxtBuscarAjuste}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><TextBlock x:Name="TxtModoOptimizar" Foreground="#FFAA42" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <StackPanel Grid.Column="1"><TextBlock x:Name="TxtTitulo" Text="Inicio" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="TxtDescripcion" Style="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
    <TextBlock x:Name="TxtDetectando" Foreground="#BBA075" FontSize="10" Visibility="Collapsed" Margin="0,4,0,0"/><ProgressBar x:Name="ProgresoDeteccion" Height="2" Maximum="100" Visibility="Collapsed" Margin="0,4,0,0"/></StackPanel>
   </Grid>
  </StackPanel>
  <Grid Grid.Row="2" x:Name="Paginas">
   <ScrollViewer x:Name="PagResumen" Visibility="Collapsed" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,0,8">
